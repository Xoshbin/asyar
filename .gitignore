# OS / editor
.DS_Store
.idea/
*.swp
*.swo

# Workspace dependencies
node_modules/
.pnpm-store/

# Only the workspace root lockfile is real; nested ones are stray artifacts of
# running install inside a package directory.
pnpm-lock.yaml
!/pnpm-lock.yaml

# Local-only agent & assistant configs/scratchpads — never tracked, anywhere in the tree
.claude/
.superpowers/
docs/superpowers/
.remember/

# Dogfood extensions live in their own repos; setup.mjs clones them here
/extensions/

# Browser companions live in their own repos; developed here, extracted later.
/browser-companions/

# Build artifacts (subpackages have their own .gitignore too — this is belt + suspenders)
dist/
build/
build-backup/
.svelte-kit/
target/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Ephemeral PR drafts and review notes
.pr-draft*
*.pr-draft*
.pr-*.md
pr-draft*
*-pr-draft.md

# Environment files
.env
.env.local
.env.*.local
.vscode/Asyar-Project.code-workspace
.agents/*
!.agents/skills/
!.agents/rules/
