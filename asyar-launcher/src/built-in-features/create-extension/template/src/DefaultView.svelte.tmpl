<script lang="ts">
  // ──────────────────────────────────────────────────────────────────────
  // DefaultView — searchable list view starter for Tier 2 extensions.
  //
  // Demonstrates the core patterns for an Asyar view:
  //   1. Search filtering via `onSearch(cb)` from `asyar-sdk/view`
  //   2. Keyboard navigation (ArrowUp / ArrowDown) via `onKey(cb)`
  //   3. Primary (Enter) + Secondary (Mod+C) actions via `context.registerAction`
  //   4. Live preferences via `context.preferences.values` + `onPreferencesChanged`
  //
  // `context` is passed from view.ts so this component never constructs a
  // second ExtensionContext (which would duplicate listeners and IPC).
  // ──────────────────────────────────────────────────────────────────────
  import { onMount, onDestroy, tick } from 'svelte';
  import {
    ActionCategory,
    ActionContext,
    onKey,
    onSearch,
    type ExtensionContext,
    type ILogService,
  } from 'asyar-sdk/view';

  interface ListItem {
    id: string;
    title: string;
    subtitle: string;
    tag: string;
    icon: string;
  }

  // Sample items — replace with your own data source or worker RPC call.
  const SAMPLE_ITEMS: ListItem[] = [
    {
      id: 'getting-started',
      title: 'Getting Started',
      subtitle: 'Customize src/DefaultView.svelte and manifest.json',
      tag: 'Guide',
      icon: 'rocket',
    },
    {
      id: 'search-filtering',
      title: 'Search & Filtering',
      subtitle: 'React to launcher search bar input with onSearch()',
      tag: 'SDK',
      icon: 'search',
    },
    {
      id: 'keyboard-nav',
      title: 'Keyboard Navigation',
      subtitle: 'Handle ArrowUp / ArrowDown events forwarded via onKey()',
      tag: 'SDK',
      icon: 'keyboard',
    },
    {
      id: 'action-panel',
      title: 'Action Panel & Shortcuts',
      subtitle: 'Register Enter primary and ⌘K secondary actions',
      tag: 'Actions',
      icon: 'terminal',
    },
    {
      id: 'preferences',
      title: 'Extension Preferences',
      subtitle: 'Edit greeting in Settings → Extensions to see live updates',
      tag: 'Config',
      icon: 'sliders',
    },
  ];

  interface Props {
    context: ExtensionContext;
    logger: ILogService;
  }
  let { context, logger }: Props = $props();

  const OPEN_ACTION_ID = `${context.extensionId}:open-item`;
  const COPY_ACTION_ID = `${context.extensionId}:copy-title`;

  let searchQuery = $state('');
  let selectedIndex = $state(0);
  let lastActionMessage = $state<string | null>(null);
  let listEl: HTMLDivElement | undefined = $state();

  // Preferences snapshot is frozen on `context.preferences.values`.
  // Bump `prefsVersion` on change so `$derived.by` re-reads reactively.
  let prefsVersion = $state(0);
  let greeting = $derived.by<string>(() => {
    prefsVersion; // eslint-disable-line @typescript-eslint/no-unused-expressions
    const val = context.preferences.values.greeting;
    return typeof val === 'string' && val.trim() ? val : 'Hello';
  });

  let filteredItems = $derived.by(() => {
    const q = searchQuery.trim().toLowerCase();
    if (!q) return SAMPLE_ITEMS;
    return SAMPLE_ITEMS.filter(
      (item) =>
        item.title.toLowerCase().includes(q) ||
        item.subtitle.toLowerCase().includes(q) ||
        item.tag.toLowerCase().includes(q),
    );
  });

  let selectedItem = $derived(filteredItems[selectedIndex] ?? null);

  function scrollSelectedIntoView(): void {
    void tick().then(() => {
      const row = listEl?.querySelector<HTMLElement>(`[data-index="${selectedIndex}"]`);
      row?.scrollIntoView({ block: 'nearest' });
    });
  }

  function activateItem(item: ListItem | null): void {
    if (!item) return;
    lastActionMessage = `Opened "${item.title}"`;
    logger.info(`${context.extensionId}: opened item "${item.id}"`);
  }

  async function copyItemTitle(item: ListItem | null): Promise<void> {
    if (!item) return;
    if (!navigator.clipboard?.writeText) {
      lastActionMessage = `Selected "${item.title}"`;
      return;
    }
    try {
      await navigator.clipboard.writeText(item.title);
      lastActionMessage = `Copied "${item.title}"`;
      logger.info(`${context.extensionId}: copied title "${item.title}"`);
    } catch {
      lastActionMessage = `Selected "${item.title}"`;
    }
  }

  function handleRowClick(index: number): void {
    selectedIndex = index;
    activateItem(filteredItems[index] ?? null);
  }

  let unsubs: Array<() => void> = [];

  onMount(() => {
    context.registerAction({
      id: OPEN_ACTION_ID,
      title: 'Open Item',
      icon: '↗',
      shortcut: 'Enter',
      primary: true,
      category: ActionCategory.PRIMARY,
      context: ActionContext.EXTENSION_VIEW,
      execute: () => activateItem(selectedItem),
    });

    context.registerAction({
      id: COPY_ACTION_ID,
      title: 'Copy Item Title',
      icon: '📋',
      shortcut: 'Mod+C',
      category: ActionCategory.EDIT,
      context: ActionContext.EXTENSION_VIEW,
      execute: () => copyItemTitle(selectedItem),
    });

    unsubs = [
      onSearch((query) => {
        searchQuery = query;
        selectedIndex = 0;
        scrollSelectedIntoView();
      }),
      onKey((event) => {
        if (filteredItems.length === 0) return;
        if (event.key === 'ArrowDown') {
          selectedIndex = Math.min(selectedIndex + 1, filteredItems.length - 1);
          scrollSelectedIntoView();
        } else if (event.key === 'ArrowUp') {
          selectedIndex = Math.max(selectedIndex - 1, 0);
          scrollSelectedIntoView();
        }
      }),
      context.onPreferencesChanged(() => {
        prefsVersion += 1;
        logger.info(
          `${context.extensionId}: preferences changed, greeting = ${String(context.preferences.values.greeting)}`,
        );
      }),
    ];
  });

  onDestroy(() => {
    context.unregisterAction(OPEN_ACTION_ID);
    context.unregisterAction(COPY_ACTION_ID);
    for (const unsub of unsubs) unsub();
  });
</script>

<div class="view-shell">
  <header class="view-header">
    <div class="header-title">
      <asyar-icon name="layers" size="16"></asyar-icon>
      <span>{greeting} from {{EXTENSION_NAME}}</span>
    </div>
    <div class="header-meta">
      {#if lastActionMessage}
        <span class="status-pill">{lastActionMessage}</span>
      {/if}
      <span class="count-label">{filteredItems.length} {filteredItems.length === 1 ? 'item' : 'items'}</span>
    </div>
  </header>

  <div class="list-container" bind:this={listEl} role="listbox" aria-label="{{EXTENSION_NAME}} items">
    {#if filteredItems.length === 0}
      <div class="empty-state">
        <asyar-icon name="search" size="24"></asyar-icon>
        <p class="empty-title">No items match "{searchQuery}"</p>
        <p class="empty-hint">Try a different search term or clear the query.</p>
      </div>
    {:else}
      {#each filteredItems as item, index (item.id)}
        <button
          type="button"
          class="list-row"
          class:selected={index === selectedIndex}
          data-index={index}
          role="option"
          aria-selected={index === selectedIndex}
          onclick={() => handleRowClick(index)}
        >
          <span class="row-icon">
            <asyar-icon name={item.icon} size="16"></asyar-icon>
          </span>
          <span class="row-body">
            <span class="row-title">{item.title}</span>
            <span class="row-subtitle">{item.subtitle}</span>
          </span>
          <span class="row-tag">{item.tag}</span>
        </button>
      {/each}
    {/if}
  </div>
</div>

