{
  "name": "File Search",
  "id": "file-search",
  "version": "1.0.0",
  "description": "Search files across your home folder",
  "type": "extension",
  "searchable": true,
  "icon": "icon:folder-search",
  "actions": [
    {
      "id": "clear-history",
      "title": "Clear Search History",
      "description": "Remove all per-query learning data",
      "icon": "icon:trash",
      "category": "System"
    }
  ],
  "commands": [
    {
      "id": "show-files",
      "name": "Search Files",
      "description": "Search files by name",
      "trigger": "files",
      "icon": "icon:folder-search",
      "mode": "view",
      "component": "DefaultView",
      "searchBarAccessory": {
        "type": "dropdown",
        "default": "all",
        "options": [
          {
            "value": "all",
            "title": "All Files"
          },
          {
            "value": "document",
            "title": "Documents"
          },
          {
            "value": "image",
            "title": "Images"
          },
          {
            "value": "code",
            "title": "Code"
          },
          {
            "value": "audio-video",
            "title": "Audio & Video"
          },
          {
            "value": "archive",
            "title": "Archives"
          },
          {
            "value": "folder",
            "title": "Folders"
          }
        ]
      }
    }
  ],
  "walkthrough": [
    {
      "id": "find-a-file",
      "title": "Find a file without opening a window",
      "summary": "Search your files straight from the launcher",
      "icon": "icon:folder-search",
      "order": 50,
      "body": "File search indexes your files locally and finds them by fuzzy name — no folder navigation, no waiting for a file manager to open. Results can be opened, revealed in the file manager, or pinned so they always come up first.\n\n## To complete the task\n\nRun **File Search** and open a file from the results.",
      "completion": {
        "type": "launch",
        "target": "cmd_file-search_*"
      }
    }
  ]
}
